rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Katalog dapat dibaca publik oleh website pelanggan.
    match /products/{productId} {
      allow read: if true;
      // Hanya akun yang login dapat menambah, mengubah, atau menghapus produk.
      allow create, update, delete: if request.auth != null;
    }
    // Pelanggan boleh membuat pesanan tanpa login.
    // Hanya admin yang login dapat membaca dan mengubah status pesanan.
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'orderId','customerName','customerPhone','fulfillment',
          'payment','items','total','status','createdAt'
        ]) &&
        request.resource.data.status == 'Baru' &&
        request.resource.data.total is number;
      allow read, update, delete: if request.auth != null;
    }
  }
}